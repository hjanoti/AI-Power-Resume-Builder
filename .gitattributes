# Normalise line endings so Windows clones do not rewrite every file.
* text=auto eol=lf

# Lockfiles are generated — collapse them in diffs and PR reviews.
package-lock.json linguist-generated=true -diff

# Treat binary assets as binary so git never tries to merge them.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary